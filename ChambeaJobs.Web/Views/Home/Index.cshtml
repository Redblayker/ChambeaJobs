@{
    ViewData["Title"] = "Inicio";
    var categorias = ViewBag.Categorias as List<CategoriaOptionDto> ?? new();
    var ubicaciones = ViewBag.Ubicaciones as List<UbicacionOptionDto> ?? new();
    var categoriasPopulares = categorias.Take(6).ToList();
}

@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Candidato"))
{
    var empresasAsociadas = ViewBag.EmpresasAsociadas as List<EmpresaResumenAsociadaDto> ?? new();

    <div class="container py-5">
        <div class="d-flex align-items-center gap-3 mb-1">
            <img src="~/images/icono-logo.png" alt="ChambeaJobs" style="height:40px; width:auto;" />
            <h2 class="mb-0">Empresas asociadas</h2>
        </div>
        <p class="text-secondary mb-4">Conoce a las empresas que ya confían en ChambeaJobs para encontrar talento.</p>

        @if (!empresasAsociadas.Any())
        {
            <div class="cj-card text-center py-5">
                <i class="fa-solid fa-building fa-2x mb-3" style="color:var(--color-slate-soft);"></i>
                <p class="small text-secondary mb-0">Todavía no hay empresas registradas.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var empresa in empresasAsociadas)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <a asp-controller="Vacante" asp-action="PerfilEmpresa" asp-route-id="@empresa.Id"
                           class="cj-card d-block h-100 text-decoration-none" style="color:inherit;">
                            <div class="text-center mb-2">
                                @if (!string.IsNullOrEmpty(empresa.LogoUrl))
                                {
                                    <img src="@empresa.LogoUrl" style="width:56px; height:56px; border-radius:var(--radius-md); object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="d-inline-flex align-items-center justify-content-center" style="width:56px; height:56px; border-radius:var(--radius-md); background:var(--color-primary-100);">
                                        <i class="fa-solid fa-building" style="color:var(--color-primary-700); font-size:1.3rem;"></i>
                                    </div>
                                }
                            </div>
                            <div class="text-center">
                                <div class="fw-semibold mb-1" style="color:var(--color-ink);">@empresa.NombreEmpresa</div>
                                @if (!string.IsNullOrEmpty(empresa.UbicacionNombre))
                                {
                                    <div class="small text-secondary mb-1"><i class="fa-solid fa-location-dot me-1"></i>@empresa.UbicacionNombre</div>
                                }
                                <span class="cj-badge @(empresa.VacantesActivas > 0 ? "cj-badge-success" : "cj-badge-info")" style="font-size:0.7rem;">
                                    @empresa.VacantesActivas vacante@(empresa.VacantesActivas == 1 ? "" : "s") activa@(empresa.VacantesActivas == 1 ? "" : "s")
                                </span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
}
else if (User.Identity?.IsAuthenticated == true)
{
    <!-- Empresa/Admin con sesión iniciada: saludo simple, sin repetir el
         buscador (ya vive en la barra lateral) ni el feed de empresas
         (eso es solo para Candidato). -->
    <section class="d-flex align-items-center justify-content-center text-center" style="min-height: 70vh;">
        <div>
            <img src="~/images/icono-logo.png" alt="ChambeaJobs" style="height:72px; width:auto; margin-bottom:24px;" />
            <h1 class="fw-bold mb-2" style="font-size:2.2rem; color:var(--color-ink);">
                Chambea<span style="color:var(--color-accent-500);">Jobs</span>
            </h1>
            <p class="text-secondary" style="font-size:1.1rem; max-width:420px; margin-inline:auto;">
                Tu próxima oportunidad laboral siempre está aquí.
            </p>
        </div>
    </section>
}
else
{
    <section class="pt-5 pb-6" style="background: linear-gradient(160deg, var(--color-primary-100) 0%, #EAF6F0 100%); position: relative; overflow: hidden;">
        <div class="position-absolute" style="top:-100px; right:-90px; width:340px; height:340px; border-radius:50%; background:radial-gradient(circle, rgba(240,102,30,0.14), transparent 70%); pointer-events:none;"></div>

        <div class="container" style="position:relative; max-width:720px;">
            <div class="text-center">
                <span class="d-inline-flex align-items-center gap-2 mb-4 px-3 py-2"
                      style="background:var(--color-white); border:1px solid var(--color-mist); border-radius:var(--radius-full); font-size:0.85rem; font-weight:600; color:var(--color-primary-700); box-shadow:var(--shadow-xs);">
                    <i class="fa-solid fa-bolt" style="color:var(--color-accent-500);"></i> La plataforma de empleo más simple de Nicaragua
                </span>

                <h1 class="fw-bold mb-2" style="font-size:2.6rem; line-height:1.1; color:var(--color-ink);">
                    Encuentra el trabajo<br />
                    <span style="color:var(--color-accent-500);">que mereces</span>
                </h1>
                <p class="text-secondary mb-4" style="font-size:1.1rem;">
                    Miles de oportunidades laborales en las mejores empresas del país.<br class="d-none d-md-block" />
                    Tu próxima carrera comienza aquí.
                </p>
            </div>

            <!-- ---------- Barra de búsqueda flotante ---------- -->
            <div class="cj-card" style="box-shadow: var(--shadow-lg); border: none;">
                <form asp-controller="Vacante" asp-action="Buscar" method="get">
                    <div class="mb-3">
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-transparent border-end-0" style="border-color:var(--color-border);">
                                <i class="fa-solid fa-magnifying-glass" style="color:var(--color-slate-soft);"></i>
                            </span>
                            <input type="text" name="q" class="form-control border-start-0" placeholder="Puesto o palabra clave" style="font-size:1rem;" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0" style="border-color:var(--color-border);">
                                    <i class="fa-solid fa-briefcase" style="color:var(--color-slate-soft);"></i>
                                </span>
                                <select name="categoriaId" class="form-select border-start-0">
                                    <option value="">Todos los rubros laborales</option>
                                    @foreach (var c in categorias)
                                    {
                                        <option value="@c.Id">@c.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0" style="border-color:var(--color-border);">
                                    <i class="fa-solid fa-location-dot" style="color:var(--color-slate-soft);"></i>
                                </span>
                                <select name="ubicacionId" class="form-select border-start-0">
                                    <option value="">Toda Nicaragua</option>
                                    @foreach (var u in ubicaciones)
                                    {
                                        <option value="@u.Id">@u.NombreCompleto</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-lg w-100 fw-bold" style="background:var(--color-ink); color:var(--color-accent-500);">
                        BUSCAR
                    </button>
                </form>
            </div>

            @if (categoriasPopulares.Any())
            {
                <div class="d-flex align-items-center flex-wrap gap-2 mt-4 justify-content-center">
                    <span class="text-secondary small">Populares:</span>
                    @foreach (var c in categoriasPopulares)
                    {
                        <a asp-controller="Vacante" asp-action="Buscar" asp-route-categoriaId="@c.Id"
                           class="px-3 py-1 text-decoration-none small fw-semibold"
                           style="border:1.5px solid var(--color-border); border-radius:var(--radius-full); color:var(--color-text); background:var(--color-white);">
                            @c.Nombre
                        </a>
                    }
                    <a asp-controller="Vacante" asp-action="Buscar"
                       class="px-3 py-1 text-decoration-none small fw-semibold"
                       style="border:1.5px solid var(--color-accent-500); border-radius:var(--radius-full); color:var(--color-accent-500); background:var(--color-white);">
                        Ver más
                    </a>
                </div>
            }

            <div class="d-flex gap-3 justify-content-center flex-wrap mt-4">
                <button type="button" class="btn cj-btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearCuenta">Crear cuenta gratis</button>
                <button type="button" class="btn cj-btn-outline" style="color:var(--color-primary-700); border-color:var(--color-primary-700);" data-bs-toggle="modal" data-bs-target="#modalRegistroEmpresa">Publicar vacante</button>
            </div>
        </div>
    </section>

    <section class="container py-6">
        <div class="text-center mb-5">
            <p class="small fw-semibold text-uppercase mb-2" style="color:var(--color-accent-500); letter-spacing:0.08em;">Cómo funciona</p>
            <h2 class="mb-0">Tres pasos, sin complicaciones</h2>
        </div>
        <div class="row text-center g-4">
            <div class="col-md-4">
                <div class="cj-card cj-card-interactive h-100">
                    <div class="d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:52px; height:52px; border-radius:var(--radius-md); background:var(--color-accent-100);">
                        <i class="fa-solid fa-user-plus" style="color: var(--color-accent-500); font-size:1.3rem;"></i>
                    </div>
                    <p class="small fw-semibold mb-1" style="color:var(--color-accent-500);">01</p>
                    <h5>Crea tu perfil</h5>
                    <p class="small text-secondary mb-0">Regístrate como candidato o empresa en minutos.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cj-card cj-card-interactive h-100">
                    <div class="d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:52px; height:52px; border-radius:var(--radius-md); background:var(--color-accent-100);">
                        <i class="fa-solid fa-magnifying-glass" style="color: var(--color-accent-500); font-size:1.3rem;"></i>
                    </div>
                    <p class="small fw-semibold mb-1" style="color:var(--color-accent-500);">02</p>
                    <h5>Busca o publica</h5>
                    <p class="small text-secondary mb-0">Explora vacantes o publica tu oferta de empleo.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cj-card cj-card-interactive h-100">
                    <div class="d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:52px; height:52px; border-radius:var(--radius-md); background:var(--color-accent-100);">
                        <i class="fa-solid fa-handshake" style="color: var(--color-accent-500); font-size:1.3rem;"></i>
                    </div>
                    <p class="small fw-semibold mb-1" style="color:var(--color-accent-500);">03</p>
                    <h5>Conecta</h5>
                    <p class="small text-secondary mb-0">Postúlate o revisa candidatos, todo en un mismo lugar.</p>
                </div>
            </div>
        </div>
    </section>
}

