@using Microsoft.AspNetCore.Identity
@using ChambeaJobs.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool EsActivo(string accion) => string.Equals(accionActual, accion, StringComparison.OrdinalIgnoreCase);

    var nombreUsuario = User.Identity?.Name ?? "Usuario";
    var inicialUsuario = nombreUsuario.Length > 0 ? nombreUsuario.Substring(0, 1).ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ChambeaJobs CRM</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/crm-theme.css" asp-append-version="true" />
</head>
<body class="cj-crm-body">
    <div class="cj-crm-shell">
        <aside class="cj-crm-sidebar">
            <a class="cj-crm-logo" asp-controller="Admin" asp-action="Dashboard">
                <img src="~/images/icono-logo.png" alt="ChambeaJobs" />
                <span>Chambea<b>CRM</b></span>
            </a>

            <nav class="cj-crm-nav">
                <a class="cj-crm-nav-item @(EsActivo("Dashboard") ? "" : "")" asp-controller="Admin" asp-action="Dashboard" title="Volver al panel general">
                    <i class="fa-solid fa-arrow-left"></i> <span>Panel general</span>
                </a>
                <div class="cj-crm-nav-titulo">CRM</div>
                <a class="cj-crm-nav-item @(EsActivo("FasesProcesoComercial") ? "activo" : "")" asp-controller="AdminCrm" asp-action="FasesProcesoComercial">
                    <i class="fa-solid fa-table-columns"></i> <span>Fases del proceso</span>
                </a>
                <a class="cj-crm-nav-item @(EsActivo("Lista") ? "activo" : "")" asp-controller="AdminCrm" asp-action="Lista">
                    <i class="fa-solid fa-building"></i> <span>Empresas</span>
                </a>
                <a class="cj-crm-nav-item @(EsActivo("Agenda") ? "activo" : "")" asp-controller="AdminCrm" asp-action="Agenda">
                    <i class="fa-solid fa-calendar-days"></i> <span>Agenda</span>
                </a>
                <a class="cj-crm-nav-item @(EsActivo("Reportes") ? "activo" : "")" asp-controller="AdminCrm" asp-action="Reportes">
                    <i class="fa-solid fa-chart-line"></i> <span>Reportes</span>
                </a>
                <a class="cj-crm-nav-item @(EsActivo("Nueva") ? "activo" : "")" asp-controller="AdminCrm" asp-action="Nueva">
                    <i class="fa-solid fa-plus"></i> <span>Nueva empresa</span>
                </a>
            </nav>

            <div class="cj-crm-sidebar-footer">
                <span class="cj-crm-avatar">@inicialUsuario</span>
                <div class="flex-grow-1">
                    <div class="small fw-semibold text-truncate" style="max-width:120px;">@nombreUsuario</div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                        <button type="submit" class="btn btn-link btn-sm p-0 text-white-50" style="font-size:0.72rem;">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i> Cerrar sesión
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="cj-crm-content">
            <header class="cj-crm-topbar">
                <a asp-controller="AdminCrm" asp-action="Lista" class="cj-crm-buscador">
                    <i class="fa-solid fa-magnifying-glass"></i> Buscar empresa...
                </a>
                <div class="d-flex align-items-center gap-3 ms-auto">
                    @await Component.InvokeAsync("NotificacionesBell")
                </div>
            </header>

            <main class="cj-crm-main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
