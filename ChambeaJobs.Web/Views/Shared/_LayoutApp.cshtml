@using Microsoft.AspNetCore.Identity
@using ChambeaJobs.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    // Controlador/acción actuales, para resaltar el item activo de la barra lateral.
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool EsActivo(string controlador, string accion) =>
        string.Equals(controladorActual, controlador, StringComparison.OrdinalIgnoreCase)
        && string.Equals(accionActual, accion, StringComparison.OrdinalIgnoreCase);

    var nombreUsuario = User.Identity?.Name ?? "Usuario";
    var inicialUsuario = nombreUsuario.Length > 0 ? nombreUsuario.Substring(0, 1).ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ChambeaJobs</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" href="~/images/favicon-512.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="cj-app-shell">
        <aside class="cj-sidebar">
            <div class="cj-sidebar-encabezado-movil">
                <div class="d-flex align-items-center gap-2">
                    <button class="cj-sidebar-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#cj-sidebar-items" aria-controls="cj-sidebar-items" aria-label="Abrir menú">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <a class="cj-sidebar-logo" asp-controller="Home" asp-action="Index">
                        <img src="~/images/icono-logo.png" alt="ChambeaJobs" />
                        <span>Chambea<b>Jobs</b></span>
                    </a>
                </div>
                <div class="d-flex align-items-center gap-3 d-lg-none">
                    @await Component.InvokeAsync("NotificacionesBell")
                    <span class="cj-avatar-topbar" title="@nombreUsuario">@inicialUsuario</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                        <button type="submit" class="btn btn-sm cj-btn-outline" title="Cerrar sesión"><i class="fa-solid fa-arrow-right-from-bracket"></i></button>
                    </form>
                </div>
            </div>

            <div class="offcanvas-lg offcanvas-start cj-sidebar-items" tabindex="-1" id="cj-sidebar-items" aria-labelledby="cj-sidebar-items-label">
            <div class="offcanvas-header d-lg-none">
                <a class="cj-sidebar-logo" asp-controller="Home" asp-action="Index" id="cj-sidebar-items-label">
                    <img src="~/images/icono-logo.png" alt="ChambeaJobs" />
                    <span>Chambea<b>Jobs</b></span>
                </a>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
            @if (User.IsInRole("Candidato"))
            {
                <div class="cj-sidebar-titulo">Mi cuenta</div>
                <a class="cj-sidebar-item @(EsActivo("Candidato", "Perfil") ? "activo" : "")" asp-controller="Candidato" asp-action="Perfil">
                    <i class="fa-solid fa-gauge"></i> Mi Perfil
                </a>
                <a class="cj-sidebar-item @(EsActivo("Vacante", "Buscar") ? "activo" : "")" asp-controller="Vacante" asp-action="Buscar">
                    <i class="fa-solid fa-briefcase"></i> Buscar Vacantes
                </a>
                <a class="cj-sidebar-item @(EsActivo("Candidato", "MisPostulaciones") ? "activo" : "")" asp-controller="Candidato" asp-action="MisPostulaciones">
                    <i class="fa-solid fa-file-lines"></i> Mis Postulaciones
                </a>
                <a class="cj-sidebar-item @(EsActivo("Pasantia", "Buscar") ? "activo" : "")" asp-controller="Pasantia" asp-action="Buscar">
                    <i class="fa-solid fa-graduation-cap"></i> Pasantías
                </a>
                <a class="cj-sidebar-item @(EsActivo("Pasantia", "MisPostulaciones") ? "activo" : "")" asp-controller="Pasantia" asp-action="MisPostulaciones">
                    <i class="fa-solid fa-file-lines"></i> Mis Pasantías
                </a>
                <div class="cj-sidebar-titulo">Cuenta</div>
                <a class="cj-sidebar-item @(EsActivo("Notificaciones", "Index") ? "activo" : "")" asp-controller="Notificaciones" asp-action="Index">
                    <i class="fa-solid fa-bell"></i> Notificaciones
                </a>
            }
            else if (User.IsInRole("Empresa"))
            {
                <div class="cj-sidebar-titulo">Empresa</div>
                <a class="cj-sidebar-item @(EsActivo("Empresa", "Dashboard") ? "activo" : "")" asp-controller="Empresa" asp-action="Dashboard">
                    <i class="fa-solid fa-gauge"></i> Panel
                </a>
                <a class="cj-sidebar-item @(EsActivo("Empresa", "MisVacantes") ? "activo" : "")" asp-controller="Empresa" asp-action="MisVacantes">
                    <i class="fa-solid fa-briefcase"></i> Mis Vacantes
                </a>
                <a class="cj-sidebar-item @(EsActivo("EmpresaPasantia", "MisPasantias") ? "activo" : "")" asp-controller="EmpresaPasantia" asp-action="MisPasantias">
                    <i class="fa-solid fa-graduation-cap"></i> Mis Pasantías
                </a>
                <a class="cj-sidebar-item @(EsActivo("Empresa", "PerfilExtendido") ? "activo" : "")" asp-controller="Empresa" asp-action="PerfilExtendido">
                    <i class="fa-solid fa-building"></i> Mi Empresa
                </a>
                <a class="cj-sidebar-item @(EsActivo("Empresa", "ComprarPaquete") || EsActivo("Empresa", "HistorialPagos") ? "activo" : "")" asp-controller="Empresa" asp-action="HistorialPagos">
                    <i class="fa-solid fa-credit-card"></i> Suscripción
                </a>
                <div class="cj-sidebar-titulo">Cuenta</div>
                <a class="cj-sidebar-item @(EsActivo("Soporte", "Contacto") ? "activo" : "")" asp-controller="Soporte" asp-action="Contacto">
                    <i class="fa-solid fa-headset"></i> Soporte
                </a>
                <a class="cj-sidebar-item @(EsActivo("Notificaciones", "Index") ? "activo" : "")" asp-controller="Notificaciones" asp-action="Index">
                    <i class="fa-solid fa-bell"></i> Notificaciones
                </a>
            }
            else if ((User.IsInRole("Administrador") || User.IsInRole("SuperAdministrador")))
            {
                <div class="cj-sidebar-titulo">Plataforma</div>
                <a class="cj-sidebar-item @(EsActivo("Admin", "Dashboard") ? "activo" : "")" asp-controller="Admin" asp-action="Dashboard">
                    <i class="fa-solid fa-gauge"></i> Panel General
                </a>
                <a class="cj-sidebar-item @(EsActivo("Admin", "GestionUsuarios") ? "activo" : "")" asp-controller="Admin" asp-action="GestionUsuarios">
                    <i class="fa-solid fa-users"></i> Usuarios
                </a>
                <a class="cj-sidebar-item @(EsActivo("Admin", "GestionEmpresas") ? "activo" : "")" asp-controller="Admin" asp-action="GestionEmpresas">
                    <i class="fa-solid fa-building"></i> Empresas
                </a>
                <a class="cj-sidebar-item @(EsActivo("Admin", "GestionVacantes") ? "activo" : "")" asp-controller="Admin" asp-action="GestionVacantes">
                    <i class="fa-solid fa-briefcase"></i> Vacantes
                </a>
                <a class="cj-sidebar-item @(EsActivo("Admin", "GestionPasantias") ? "activo" : "")" asp-controller="Admin" asp-action="GestionPasantias">
                    <i class="fa-solid fa-graduation-cap"></i> Pasantías
                </a>
                <div class="cj-sidebar-titulo">Finanzas</div>
                <a class="cj-sidebar-item @(EsActivo("Admin", "PagosPendientes") || EsActivo("Admin", "HistorialPagos") ? "activo" : "")" asp-controller="Admin" asp-action="PagosPendientes">
                    <i class="fa-solid fa-receipt"></i> Pagos y Suscripciones
                </a>
                <a class="cj-sidebar-item" asp-controller="AdminCrm" asp-action="FasesProcesoComercial">
                    <i class="fa-solid fa-table-columns"></i> CRM <span class="badge bg-primary-subtle text-primary" style="font-size:0.6rem;">nuevo</span>
                </a>
                @if (User.IsInRole("SuperAdministrador") || User.IsInRole("AdministradorFinanciero") || User.IsInRole("SupervisorFinanciero") || User.IsInRole("AuditorFinanciero"))
                {
                    <a class="cj-sidebar-item" asp-controller="AdminFinanzas" asp-action="Dashboard">
                        <i class="fa-solid fa-sack-dollar"></i> Contabilidad y Finanzas <span class="badge bg-danger-subtle text-danger" style="font-size:0.6rem;">confidencial</span>
                    </a>
                }
                <div class="cj-sidebar-titulo">Sistema</div>
                <a class="cj-sidebar-item @(EsActivo("Admin", "Auditoria") ? "activo" : "")" asp-controller="Admin" asp-action="Auditoria">
                    <i class="fa-solid fa-clipboard-list"></i> Auditoría
                </a>
                <a class="cj-sidebar-item @(EsActivo("Admin", "Soporte") ? "activo" : "")" asp-controller="Admin" asp-action="Soporte">
                    <i class="fa-solid fa-headset"></i> Soporte
                </a>
                <a class="cj-sidebar-item @(EsActivo("Admin", "Configuracion") ? "activo" : "")" asp-controller="Admin" asp-action="Configuracion">
                    <i class="fa-solid fa-gear"></i> Configuración
                </a>
                <a class="cj-sidebar-item @(EsActivo("Account", "ConfigurarDobleFactor") ? "activo" : "")" asp-controller="Account" asp-action="ConfigurarDobleFactor">
                    <i class="fa-solid fa-shield-halved"></i> Verificación en 2 pasos
                </a>
            }
            </div>
        </div>
        </aside>

        <div class="cj-content-area">
            <div class="cj-topbar">
                <a asp-controller="Vacante" asp-action="Buscar" class="text-decoration-none small text-secondary d-none d-md-flex align-items-center gap-2" style="background:var(--color-mist-soft); border-radius:10px; padding:9px 16px; width:320px;">
                    <i class="fa-solid fa-magnifying-glass"></i> Buscar vacantes...
                </a>
                <div class="d-none d-lg-flex align-items-center gap-3 ms-auto">
                    @await Component.InvokeAsync("NotificacionesBell")
                    <span class="cj-avatar-topbar" title="@nombreUsuario">@inicialUsuario</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                        <button type="submit" class="btn btn-sm cj-btn-outline" title="Cerrar sesión"><i class="fa-solid fa-arrow-right-from-bracket"></i></button>
                    </form>
                </div>
            </div>

            <main class="cj-main">
                @RenderBody()
                <partial name="_Paginacion" />
            </main>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // ---------- Notificaciones en tiempo real ----------
        (function () {
            const conexion = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/notificaciones")
                .withAutomaticReconnect()
                .build();

            conexion.on("NuevaNotificacion", function (contadorNoLeidas) {
                const contadores = document.querySelectorAll('.js-contador-notificaciones');
                contadores.forEach(function (contador) {
                    if (contadorNoLeidas > 0) {
                        contador.textContent = contadorNoLeidas > 9 ? '9+' : contadorNoLeidas;
                        contador.style.display = '';
                    } else {
                        contador.style.display = 'none';
                    }
                });

                // Pequeña animación para que se note que llegó algo nuevo.
                document.querySelectorAll('.js-campana-notificaciones').forEach(function (campana) {
                    campana.style.transition = 'transform 0.2s ease';
                    campana.style.transform = 'scale(1.15)';
                    setTimeout(() => { campana.style.transform = ''; }, 250);
                });
            });

            conexion.start().catch(() => {
                // Si falla la conexión (ej. red inestable), la campanita sigue
                // funcionando normal, solo sin la actualización instantánea.
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (!(User.IsInRole("Administrador") || User.IsInRole("SuperAdministrador")))
    {
        <partial name="_ChatbotWidget" />
    }
</body>
</html>
