@model RecuperarPasswordDto
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="cj-card">
                <div class="text-center mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:56px; height:56px; border-radius:50%; background:var(--color-primary-100);">
                        <i class="fa-solid fa-key" style="color:var(--color-primary-700); font-size:1.3rem;"></i>
                    </div>
                </div>
                <h2 class="mb-3 text-center">Recuperar contraseña</h2>
                <p class="small text-secondary text-center mb-4">
                    Escribe el correo con el que te registraste y te ayudaremos a restablecer tu contraseña.
                </p>

                <form asp-controller="Account" asp-action="RecuperarPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Correo" class="form-label">Correo electrónico</label>
                        <input asp-for="Correo" class="form-control" placeholder="tucorreo@ejemplo.com" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn cj-btn-primary w-100 mb-3">Enviar enlace de recuperación</button>

                    <p class="text-center small mb-0">
                        <a asp-controller="Account" asp-action="Login">Volver a inicio de sesión</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>
