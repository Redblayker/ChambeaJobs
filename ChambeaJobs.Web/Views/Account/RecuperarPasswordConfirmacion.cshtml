@{
    ViewData["Title"] = "Revisa tu correo";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="cj-card text-center">
                <div class="d-inline-flex align-items-center justify-content-center mb-3 mx-auto" style="width:64px; height:64px; border-radius:50%; background:#DEF4E9;"><i class="fa-solid fa-envelope-circle-check fa-lg" style="color: var(--color-success);"></i></div>
                <h2 class="mb-3">Revisa tu correo</h2>
                <p class="text-secondary mb-4">
                    Si el correo que ingresaste está registrado en ChambeaJobs, te enviamos un enlace para
                    restablecer tu contraseña. El enlace es válido por un tiempo limitado.
                </p>

                @if (ViewBag.EnlaceRestablecer != null)
                {
                    <div class="alert alert-warning text-start">
                        <strong>Modo desarrollo/demo:</strong> este proyecto todavía no tiene un servidor de
                        correo (SMTP) configurado, así que en vez de enviarte un email, aquí está el enlace
                        directo para que puedas probar el flujo completo:
                        <div class="mt-2">
                            <a href="@ViewBag.EnlaceRestablecer" class="d-block text-break">@ViewBag.EnlaceRestablecer</a>
                        </div>
                    </div>
                }

                <a asp-controller="Account" asp-action="Login" class="btn cj-btn-primary">Volver a inicio de sesión</a>
            </div>
        </div>
    </div>
</div>
