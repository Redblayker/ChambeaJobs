@model RestablecerPasswordDto
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="cj-card">
                <div class="text-center mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:56px; height:56px; border-radius:50%; background:var(--color-primary-100);">
                        <i class="fa-solid fa-lock" style="color:var(--color-primary-700); font-size:1.3rem;"></i>
                    </div>
                </div>
                <h2 class="mb-4 text-center">Crea tu nueva contraseña</h2>

                <form asp-controller="Account" asp-action="RestablecerPassword" method="post">
                    <input type="hidden" asp-for="UsuarioId" />
                    <input type="hidden" asp-for="Token" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Nueva contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarPassword" class="form-label">Confirmar nueva contraseña</label>
                        <input asp-for="ConfirmarPassword" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn cj-btn-primary w-100">Guardar nueva contraseña</button>
                </form>
            </div>
        </div>
    </div>
</div>
