@{
    ViewData["Title"] = "Contraseña actualizada";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="cj-card text-center">
                <div class="d-inline-flex align-items-center justify-content-center mb-3 mx-auto" style="width:64px; height:64px; border-radius:50%; background:#DEF4E9;"><i class="fa-solid fa-circle-check fa-lg" style="color: var(--color-success);"></i></div>
                <h2 class="mb-3">Contraseña actualizada</h2>
                <p class="text-secondary mb-4">
                    Tu contraseña se cambió correctamente. Ya puedes iniciar sesión con tu nueva contraseña.
                </p>
                <a asp-controller="Account" asp-action="Login" class="btn cj-btn-primary">Iniciar sesión</a>
            </div>
        </div>
    </div>
</div>
