@model VacanteDetalleDto
@{
    ViewData["Title"] = Model.Titulo;
    var esCandidato = (bool)(ViewBag.EsCandidato ?? false);
    var yaPostulo = (bool)(ViewBag.YaPostulo ?? false);
}

<div class="container py-5">
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="cj-card mb-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div class="d-flex gap-3">
                        @if (!string.IsNullOrEmpty(Model.EmpresaLogoUrl))
                        {
                            <img src="@Model.EmpresaLogoUrl" style="width:56px; height:56px; border-radius:var(--radius-md); object-fit:contain; background:white; border:1px solid var(--color-mist); padding:4px; flex-shrink:0;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:56px; height:56px; border-radius:var(--radius-md); background:var(--color-primary-100);">
                                <i class="fa-solid fa-building" style="color:var(--color-primary-700); font-size:1.2rem;"></i>
                            </div>
                        }
                        <div>
                            <h2 class="mb-1">
                                @Model.Titulo
                                @if (Model.EsDestacada)
                                {
                                    <span class="cj-badge" style="background:#F0B429; color:#12161C; vertical-align:middle;">
                                        <i class="fa-solid fa-star"></i> Destacada
                                    </span>
                                }
                            </h2>
                            <p class="text-secondary mb-2">
                                <a asp-controller="Vacante" asp-action="PerfilEmpresa" asp-route-id="@Model.EmpresaId" class="text-decoration-none" style="color:inherit;">
                                    @Model.EmpresaNombre <i class="fa-solid fa-arrow-up-right-from-square small"></i>
                                </a>
                            </p>
                            <div class="d-flex gap-2 flex-wrap">
                                <span class="cj-badge cj-badge-info">@Model.UbicacionNombre</span>
                                <span class="cj-badge cj-badge-info">@Model.Modalidad</span>
                                <span class="cj-badge cj-badge-info">@Model.CategoriaNombre</span>
                                @if (!string.IsNullOrEmpty(Model.ExperienciaRequerida))
                                {
                                    <span class="cj-badge cj-badge-info"><i class="fa-solid fa-briefcase me-1"></i>@Model.ExperienciaRequerida</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (Model.SalarioMin.HasValue || Model.SalarioMax.HasValue)
                    {
                        <div class="text-end">
                            <div class="fs-5 fw-bold" style="color:var(--color-success);">
                                @(Model.SalarioMin?.ToString("C0") ?? "") @(Model.SalarioMin.HasValue && Model.SalarioMax.HasValue ? " - " : "") @(Model.SalarioMax?.ToString("C0") ?? "")
                            </div>
                        </div>
                    }
                </div>

                <hr />

                <h5>Descripción</h5>
                <p style="white-space:pre-line;">@Model.Descripcion</p>

                @if (!string.IsNullOrEmpty(Model.Requisitos))
                {
                    <h5>Requisitos</h5>
                    <p style="white-space:pre-line;">@Model.Requisitos</p>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="cj-card" style="position:sticky; top:var(--space-4);">
                @if (Model.Estado != "Activa")
                {
                    <div class="alert alert-secondary small">Esta vacante ya no acepta postulaciones.</div>
                }
                else if (!esCandidato)
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Detalle", "Vacante", new { id = Model.Id })" class="btn cj-btn-primary w-100 mb-2">
                        Inicia sesión para aplicar
                    </a>
                }
                else if (yaPostulo)
                {
                    <button class="btn cj-btn-outline w-100 mb-2" style="color:var(--color-primary-700); border-color:var(--color-primary-700);" disabled>
                        <i class="fa-solid fa-check me-1"></i> Ya postulado
                    </button>
                }
                else
                {
                    <form asp-controller="Vacante" asp-action="Aplicar" method="post" class="mb-2">
                        <input type="hidden" name="vacanteId" value="@Model.Id" />
                        <button type="submit" class="btn cj-btn-primary w-100">Aplicar a esta vacante</button>
                    </form>
                }

                <hr />
                <div class="small text-secondary d-flex flex-column gap-2">
                    <div><i class="fa-regular fa-calendar me-2" style="width:14px;"></i>Publicada: @Model.FechaPublicacion.ToString("dd/MM/yyyy")</div>
                    <div><i class="fa-regular fa-clock me-2" style="width:14px;"></i>Cierra: @Model.FechaCierre.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
    </div>
</div>
