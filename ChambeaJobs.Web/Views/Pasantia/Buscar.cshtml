@model List<PasantiaDetalleDto>
@{
    ViewData["Title"] = "Buscar pasantías";
    var categorias = ViewBag.Categorias as List<CategoriaOptionDto> ?? new();
    var ubicaciones = ViewBag.Ubicaciones as List<UbicacionOptionDto> ?? new();
}

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-1">
        <div class="d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px; height:44px; border-radius:var(--radius-md); background:#F3EBFB;">
            <i class="fa-solid fa-graduation-cap" style="color:#7C3AED;"></i>
        </div>
        <h2 class="mb-0">Programa de Pasantías</h2>
    </div>
    <p class="text-secondary mb-4">Oportunidades de práctica profesional para estudiantes y recién graduados.</p>

    <div class="cj-card mb-4" style="padding: var(--space-3);">
        <form asp-controller="Pasantia" asp-action="Buscar" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-color:var(--color-border);">
                        <i class="fa-solid fa-magnifying-glass" style="color:var(--color-slate-soft);"></i>
                    </span>
                    <input type="text" name="q" value="@ViewBag.PalabraClave" class="form-control border-start-0" placeholder="Puesto, palabra clave..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoriaId" class="form-select">
                    <option value="">Todas las categorías</option>
                    @foreach (var c in categorias)
                    {
                        <option value="@c.Id" selected="@(ViewBag.CategoriaId == c.Id)">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="ubicacionId" class="form-select">
                    <option value="">Todas las ubicaciones</option>
                    @foreach (var u in ubicaciones)
                    {
                        <option value="@u.Id" selected="@(ViewBag.UbicacionId == u.Id)">@u.NombreCompleto</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn w-100" style="background:#7C3AED; color:white;">Buscar</button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="cj-card text-center py-5">
            <i class="fa-solid fa-folder-open fa-2x mb-3" style="color:var(--color-slate-soft);"></i>
            <h5 class="mb-1">No encontramos pasantías con esos filtros</h5>
            <p class="small text-secondary mb-0">Intenta con otra palabra clave o quita algún filtro.</p>
        </div>
    }
    else
    {
        <p class="small text-secondary mb-3">@Model.Count pasantía@(Model.Count == 1 ? "" : "s") encontrada@(Model.Count == 1 ? "" : "s")</p>
        <div class="row g-3">
            @foreach (var p in Model)
            {
                <div class="col-md-6">
                    <a asp-controller="Pasantia" asp-action="Detalle" asp-route-id="@p.Id" class="text-decoration-none">
                        <div class="cj-card cj-card-interactive h-100" style="border-left: 3px solid #7C3AED;">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="d-flex gap-3">
                                    @if (!string.IsNullOrEmpty(p.EmpresaLogoUrl))
                                    {
                                        <img src="@p.EmpresaLogoUrl" style="width:44px; height:44px; border-radius:var(--radius-sm); object-fit:cover; flex-shrink:0;" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center flex-shrink-0"
                                             style="width:44px; height:44px; border-radius:var(--radius-sm); background:#F3EBFB;">
                                            <i class="fa-solid fa-building" style="color:#7C3AED;"></i>
                                        </div>
                                    }
                                    <div>
                                        <h5 class="mb-1" style="color:var(--color-text); font-size:1.05rem;">@p.Titulo</h5>
                                        <div class="small text-secondary">@p.EmpresaNombre</div>
                                    </div>
                                </div>
                                <span class="cj-badge" style="background:#F3EBFB; color:#6D28D9;">@p.Modalidad</span>
                            </div>

                            <div class="small fw-semibold mt-2" style="color:#6D28D9;">
                                @(p.EsRemunerada ? (p.MontoRemuneracion.HasValue ? $"Remunerada · C${p.MontoRemuneracion:0}/mes" : "Remunerada") : "No remunerada")
                                · @p.DuracionMeses mes@(p.DuracionMeses == 1 ? "" : "es")
                            </div>

                            <div class="d-flex gap-2 mt-3 flex-wrap">
                                <span class="cj-badge cj-badge-info"><i class="fa-solid fa-location-dot" style="font-size:10px;"></i> @p.UbicacionNombre</span>
                                <span class="cj-badge cj-badge-info">@p.CategoriaNombre</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
