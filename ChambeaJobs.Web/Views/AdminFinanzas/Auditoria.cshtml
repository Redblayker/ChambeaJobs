@model List<AuditoriaFinancieraDto>
@{
    ViewData["Title"] = "Auditoría - Finanzas";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0" style="font-size:1.3rem;">Auditoría financiera</h2>
        <a asp-action="Dashboard" class="btn cj-btn-outline btn-sm">← Dashboard</a>
    </div>

    <div class="cj-card p-0">
        <table class="table table-hover mb-0 align-middle" style="font-size:0.8rem;">
            <thead><tr><th>Fecha/Hora</th><th>Usuario</th><th>Módulo</th><th>Acción</th><th>Registro</th><th>Detalle</th><th>Resultado</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@a.UsuarioNombre</td>
                        <td>@a.Modulo</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@a.Accion</span></td>
                        <td>@a.RegistroAfectado</td>
                        <td class="text-secondary">@a.ValorNuevo</td>
                        <td>
                            @if (a.Resultado == "Exito") { <span class="text-success"><i class="fa-solid fa-check"></i></span> }
                            else { <span class="text-danger"><i class="fa-solid fa-xmark"></i> @a.Resultado</span> }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">Todavía no hay actividad registrada.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
