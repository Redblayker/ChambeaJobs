@model List<GastoFinancieroDto>
@{
    ViewData["Title"] = "Gastos - Finanzas";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0" style="font-size:1.3rem;">Gastos</h2>
            <p class="text-secondary small mb-0">Hosting, dominio, publicidad y demás gastos de la operación.</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("SuperAdministrador") || User.IsInRole("AdministradorFinanciero"))
            {
                <a asp-action="NuevoGasto" class="btn cj-btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Nuevo gasto</a>
            }
            <a asp-action="Dashboard" class="btn cj-btn-outline btn-sm">← Dashboard</a>
        </div>
    </div>

    @if (TempData["Exito"] != null) { <div class="alert alert-success">@TempData["Exito"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="cj-card p-0">
        <table class="table table-hover mb-0 align-middle" style="font-size:0.85rem;">
            <thead>
                <tr>
                    <th>Descripción</th><th>Categoría</th><th>Proveedor</th><th>Monto</th><th>Método</th>
                    <th>Fecha</th><th>Comprobante</th><th>Registrado por</th><th>Estado</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr class="@(g.Estado == "Anulado" ? "text-decoration-line-through text-secondary" : "")">
                        <td>@g.Descripcion</td>
                        <td>@g.CategoriaFinanciera</td>
                        <td>@(g.Proveedor ?? "—")</td>
                        <td class="fw-bold">$@g.Monto.ToString("0.00") @g.Moneda</td>
                        <td>@g.MetodoPago</td>
                        <td>@g.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(g.RutaComprobante))
                            {
                                <a href="@g.RutaComprobante" target="_blank"><i class="fa-solid fa-paperclip"></i></a>
                            }
                            else { <span class="text-secondary">—</span> }
                        </td>
                        <td class="small">@g.RegistradoPor</td>
                        <td><span class="badge @(g.Estado == "Activo" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@g.Estado</span></td>
                        <td>
                            @if (g.Estado == "Activo" && (User.IsInRole("SuperAdministrador") || User.IsInRole("AdministradorFinanciero")))
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalAnularG@(g.Id)">Anular</button>
                                <div class="modal fade" id="modalAnularG@(g.Id)" tabindex="-1">
                                    <div class="modal-dialog">
                                        <form asp-action="AnularGasto" asp-route-id="@g.Id" method="post" class="modal-content">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-header"><h6 class="modal-title">Anular gasto</h6></div>
                                            <div class="modal-body">
                                                <label class="form-label small">Motivo (obligatorio)</label>
                                                <textarea name="Motivo" class="form-control" required></textarea>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-sm cj-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-sm btn-danger">Confirmar anulación</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="text-center text-secondary py-4">Todavía no hay gastos registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
