@model List<IngresoFinancieroDto>
@{
    ViewData["Title"] = "Ingresos - Finanzas";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0" style="font-size:1.3rem;">Ingresos</h2>
            <p class="text-secondary small mb-0">Se generan automáticamente cuando se aprueba un pago — no se crean a mano.</p>
        </div>
        <a asp-action="Dashboard" class="btn cj-btn-outline btn-sm">← Dashboard</a>
    </div>

    @if (TempData["Exito"] != null) { <div class="alert alert-success">@TempData["Exito"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="cj-card p-0">
        <table class="table table-hover mb-0 align-middle" style="font-size:0.85rem;">
            <thead>
                <tr>
                    <th>Empresa</th><th>Plan</th><th>Categoría</th><th>Monto</th><th>Método</th>
                    <th>Referencia</th><th>Fecha</th><th>Período</th><th>Estado</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr class="@(i.Estado == "Anulado" ? "text-decoration-line-through text-secondary" : "")">
                        <td>@i.NombreEmpresa</td>
                        <td>@(i.NombrePlan ?? "—")</td>
                        <td>@i.CategoriaFinanciera</td>
                        <td class="fw-bold">$@i.Monto.ToString("0.00") @i.Moneda</td>
                        <td>@i.MetodoPago</td>
                        <td>@(i.Referencia ?? "—")</td>
                        <td>@i.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        <td>@i.PeriodoNombre</td>
                        <td><span class="badge @(i.Estado == "Activo" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@i.Estado</span></td>
                        <td>
                            @if (i.Estado == "Activo" && User.IsInRole("SuperAdministrador") || User.IsInRole("AdministradorFinanciero"))
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalAnular@(i.Id)">Anular</button>
                                <div class="modal fade" id="modalAnular@(i.Id)" tabindex="-1">
                                    <div class="modal-dialog">
                                        <form asp-action="AnularIngreso" asp-route-id="@i.Id" method="post" class="modal-content">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-header"><h6 class="modal-title">Anular ingreso</h6></div>
                                            <div class="modal-body">
                                                <label class="form-label small">Motivo (obligatorio)</label>
                                                <textarea name="Motivo" class="form-control" required></textarea>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-sm cj-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-sm btn-danger">Confirmar anulación</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="text-center text-secondary py-4">Todavía no hay ingresos registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
