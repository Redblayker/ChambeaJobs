@model GastoFinancieroFormDto
@{
    ViewData["Title"] = "Nuevo gasto - Finanzas";
    var categorias = ViewBag.Categorias as List<CategoriaFinancieraDto> ?? new();
}

<div class="container-fluid py-3" style="max-width:700px;">
    <h2 class="mb-3" style="font-size:1.3rem;">Registrar gasto</h2>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form asp-action="NuevoGasto" method="post" enctype="multipart/form-data" class="cj-card">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Categoría</label>
            <select asp-for="CategoriaFinancieraId" class="form-select">
                <option value="">Selecciona...</option>
                @foreach (var c in categorias.Where(c => c.Activa))
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
            @if (!categorias.Any())
            {
                <div class="form-text text-danger">No hay categorías de tipo Gasto todavía — créala primero en <a asp-action="Categorias">Categorías</a>.</div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <input asp-for="Descripcion" class="form-control" placeholder="Ej. Hosting mensual MonsterASP" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Proveedor</label>
                <input asp-for="Proveedor" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Fecha</label>
                <input asp-for="Fecha" type="date" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Monto</label>
                <input asp-for="Monto" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Moneda</label>
                <select asp-for="Moneda" class="form-select">
                    <option value="USD">USD</option>
                    <option value="NIO">NIO</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Método de pago</label>
                <input asp-for="MetodoPago" class="form-control" placeholder="Transferencia, tarjeta..." />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Número de referencia (opcional)</label>
            <input asp-for="NumeroReferencia" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Comprobante (opcional — PDF, JPG o PNG, máx. 5 MB)</label>
            <input type="file" name="comprobante" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
        </div>

        <button type="submit" class="btn cj-btn-primary">Registrar gasto</button>
        <a asp-action="Gastos" class="btn cj-btn-outline">Cancelar</a>
    </form>
</div>
