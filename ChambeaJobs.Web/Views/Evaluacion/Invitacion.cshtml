@model InvitacionEvaluacionDto
@{
    ViewData["Title"] = "Invitación a evaluación";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Evaluación psicométrica - ChambeaJobs</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha384-PPIZEGYM1v8zp5Py7UjFb79S58UeqCL9pYVnVPURKEqvioPROaVAJKKLzvH2rDnI" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background: linear-gradient(135deg, var(--color-primary-700), var(--color-primary-900)); min-height:100vh;">
    <div class="container py-5 d-flex align-items-center justify-content-center" style="min-height:100vh;">
        <div class="cj-card" style="max-width:560px; width:100%;">
            <div class="text-center mb-3">
                <span class="fw-bold" style="font-family:var(--font-heading); font-size:1.4rem;">
                    Chambea<span class="cj-brand-accent">Jobs</span>
                </span>
            </div>

            <p class="text-center small text-secondary mb-1">@Model.EmpresaNombre te invita a evaluarte para:</p>
            <h1 class="text-center mb-3" style="font-size:1.6rem;">@Model.VacanteTitulo</h1>
            <h2 class="text-center mb-4" style="font-size:1.3rem; color:var(--color-accent-500);">Evaluación de Personalidad Big Five</h2>

            @if (!string.IsNullOrEmpty(Model.Mensaje))
            {
                <div class="alert alert-info small">@Model.Mensaje</div>
            }

            <p class="text-center text-secondary mb-4">
                Esta prueba nos ayuda a comprender mejor tu perfil profesional y a encontrar la vacante ideal para ti.
            </p>

            <div class="row text-center mb-4">
                <div class="col-6">
                    <i class="fa-regular fa-clock fa-lg mb-2" style="color:var(--color-primary-700);"></i>
                    <div class="fw-semibold">~10 minutos</div>
                    <div class="small text-secondary">Tiempo estimado</div>
                </div>
                <div class="col-6">
                    <i class="fa-solid fa-list-check fa-lg mb-2" style="color:var(--color-primary-700);"></i>
                    <div class="fw-semibold">@Model.TotalPreguntas preguntas</div>
                    <div class="small text-secondary">Escala de acuerdo</div>
                </div>
            </div>

            <div class="alert alert-warning small">
                <strong>Antes de comenzar:</strong>
                <ul class="mb-0 mt-1">
                    <li>Responde con honestidad, no hay respuestas correctas o incorrectas.</li>
                    <li>Puedes guardar tu progreso y continuar después si lo necesitas.</li>
                    <li>Fecha límite para completarla: @Model.FechaLimite.ToString("dd/MM/yyyy")</li>
                </ul>
            </div>

            <a asp-controller="Evaluacion" asp-action="Realizar" asp-route-id="@Model.EvaluacionId" class="btn cj-btn-primary btn-lg w-100">
                Comenzar evaluación
            </a>
            <a asp-controller="Candidato" asp-action="MisPostulaciones" class="d-block text-center small mt-3">
                Volver más tarde
            </a>
        </div>
    </div>
</body>
</html>
