@model ResultadoEvaluacionDto
@{
    ViewData["Title"] = "Mi resultado de evaluación";

    string IconoRasgo(string nombre) => nombre.ToLower() switch
    {
        var n when n.Contains("responsabilidad") => "fa-solid fa-list-check",
        var n when n.Contains("extraversión") || n.Contains("extraversion") => "fa-solid fa-comments",
        var n when n.Contains("amabilidad") => "fa-solid fa-handshake",
        var n when n.Contains("apertura") => "fa-solid fa-lightbulb",
        var n when n.Contains("estabilidad") => "fa-solid fa-heart-pulse",
        _ => "fa-solid fa-chart-simple"
    };
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success">@TempData["Exito"]</div>
            }

            <div class="cj-card p-0 overflow-hidden mb-4">
                <div style="height:70px; background:linear-gradient(135deg, var(--color-primary-900), var(--color-primary-700));"></div>
                <div class="text-center px-4 pt-3 pb-4">
                    <p class="small mb-1" style="color:var(--color-slate-soft);">Evaluación de Personalidad Big Five</p>
                    <h2 class="mb-3">@Model.VacanteTitulo <span class="fw-normal" style="color:var(--color-slate-soft);">&middot; @Model.EmpresaNombre</span></h2>

                    <div class="d-inline-flex flex-column align-items-center justify-content-center mx-auto"
                         style="width:160px; height:160px; border-radius:50%; background:var(--color-accent-100); border:4px solid var(--color-accent-300);">
                        <span class="fs-1 fw-bold" style="color:var(--color-accent-700);">@Model.PuntajeCompatibilidad%</span>
                        <span class="small" style="color:var(--color-slate-soft);">Compatibilidad</span>
                    </div>

                    <p class="small mt-3 mb-0" style="color:var(--color-slate-soft);">Completada el @Model.FechaCompletado.ToString("dd/MM/yyyy")</p>
                </div>
            </div>

            <div class="cj-card">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <div class="d-flex align-items-center justify-content-center flex-shrink-0" style="width:34px;height:34px;border-radius:var(--radius-sm);background:var(--color-accent-100);">
                        <i class="fa-solid fa-chart-simple" style="color:var(--color-accent-700);"></i>
                    </div>
                    <h5 class="mb-0">Tu perfil por rasgo</h5>
                </div>
                @{ var i = 0; }
                @foreach (var rasgo in Model.Rasgos)
                {
                    var colorBarra = i % 2 == 0 ? "var(--color-primary-700)" : "var(--color-accent-500)";
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold"><i class="@IconoRasgo(rasgo.Nombre) me-2" style="color:@colorBarra; width:16px;"></i>@rasgo.Nombre</span>
                            <span class="small" style="color:var(--color-slate-soft);">@rasgo.Interpretacion &middot; @rasgo.Puntaje%</span>
                        </div>
                        <div class="progress" style="height:10px; background-color:var(--color-mist);">
                            <div class="progress-bar" role="progressbar" style="width:@(rasgo.Puntaje)%; background-color:@colorBarra;"></div>
                        </div>
                    </div>
                    i++;
                }
            </div>

            <a asp-controller="Candidato" asp-action="MisPostulaciones" class="btn cj-btn-outline mt-4" style="color:var(--color-primary-700); border-color:var(--color-primary-700);">
                <i class="fa-solid fa-arrow-left me-1"></i>Volver a mis postulaciones
            </a>
        </div>
    </div>
</div>
