@model RealizarEvaluacionDto
@{
    ViewData["Title"] = "Evaluación en curso";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Evaluación en curso - ChambeaJobs</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha384-PPIZEGYM1v8zp5Py7UjFb79S58UeqCL9pYVnVPURKEqvioPROaVAJKKLzvH2rDnI" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .cj-likert-option {
            display: flex; align-items: center; gap: 12px;
            border: 1.5px solid var(--color-border);
            border-radius: var(--radius-md);
            padding: 12px 16px;
            cursor: pointer;
            transition: all .15s ease;
            background: var(--color-white);
        }
        .cj-likert-option:hover { border-color: var(--color-accent-300); }
        .cj-likert-option.selected {
            border-color: var(--color-accent-500);
            background: var(--color-accent-100);
            font-weight: 600;
        }
        .cj-likert-dot {
            width: 18px; height: 18px; border-radius: 50%;
            border: 2px solid var(--color-gray-300); flex-shrink: 0;
        }
        .cj-likert-option.selected .cj-likert-dot {
            border-color: var(--color-accent-500);
            background: var(--color-accent-500);
        }
        .cj-question-step { display: none; }
        .cj-question-step.active { display: block; }
    </style>
</head>
<body style="background: var(--color-gray-100); min-height:100vh;">

    <header class="d-flex justify-content-between align-items-center px-4 py-3" style="background:var(--color-white); border-bottom:1px solid var(--color-border);">
        <span class="fw-bold" style="font-family:var(--font-heading);">
            Chambea<span class="cj-brand-accent">Jobs</span>
        </span>
        <span class="small text-secondary"><span id="contador-preguntas">1</span> de @Model.Preguntas.Count</span>
    </header>

    <div class="progress" style="height:6px; border-radius:0;">
        <div class="progress-bar" id="barra-progreso" style="width:@(100/Model.Preguntas.Count)%; background-color:var(--color-accent-500);"></div>
    </div>

    <div class="container py-5" style="max-width:640px;">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form id="form-evaluacion" asp-controller="Evaluacion" asp-action="Finalizar" method="post">
            <input type="hidden" name="evaluacionId" value="@Model.EvaluacionId" />

            @for (int i = 0; i < Model.Preguntas.Count; i++)
            {
                var pregunta = Model.Preguntas[i];
                <div class="cj-question-step @(i == 0 ? "active" : "")" data-indice="@i">
                    <div class="cj-card">
                        <h4 class="mb-4">@pregunta.Texto</h4>

                        <div class="d-flex flex-column gap-2" data-pregunta-id="@pregunta.PreguntaId">
                            @{
                                var opciones = new[] {
                                    (1, "Totalmente en desacuerdo"), (2, "En desacuerdo"), (3, "Neutral"),
                                    (4, "De acuerdo"), (5, "Totalmente de acuerdo")
                                };
                            }
                            @foreach (var (valor, etiqueta) in opciones)
                            {
                                <label class="cj-likert-option @(pregunta.ValorSeleccionado == valor ? "selected" : "")">
                                    <span class="cj-likert-dot"></span>
                                    <input type="radio" name="respuestas[@pregunta.PreguntaId]" value="@valor"
                                           class="d-none cj-likert-input"
                                           checked="@(pregunta.ValorSeleccionado == valor)" />
                                    @etiqueta
                                </label>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        @if (i > 0)
                        {
                            <button type="button" class="btn cj-btn-outline btn-nav-prev">Anterior</button>
                        }
                        else
                        {
                            <span></span>
                        }

                        @if (i < Model.Preguntas.Count - 1)
                        {
                            <button type="button" class="btn cj-btn-primary btn-nav-next">Siguiente</button>
                        }
                        else
                        {
                            <button type="submit" class="btn cj-btn-primary" id="btn-finalizar">Finalizar evaluación</button>
                        }
                    </div>
                </div>
            }
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
    <script>
        (function () {
            const pasos = document.querySelectorAll('.cj-question-step');
            const total = pasos.length;
            const barra = document.getElementById('barra-progreso');
            const contador = document.getElementById('contador-preguntas');
            let indiceActual = 0;

            function mostrarPaso(indice) {
                pasos.forEach(p => p.classList.remove('active'));
                pasos[indice].classList.add('active');
                contador.textContent = indice + 1;
                barra.style.width = (((indice + 1) / total) * 100) + '%';
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            document.querySelectorAll('.btn-nav-next').forEach(btn => {
                btn.addEventListener('click', function () {
                    const grupo = pasos[indiceActual].querySelector('[data-pregunta-id]');
                    const seleccionado = grupo.querySelector('.cj-likert-input:checked');
                    if (!seleccionado) {
                        alert('Selecciona una opción antes de continuar.');
                        return;
                    }
                    if (indiceActual < total - 1) {
                        indiceActual++;
                        mostrarPaso(indiceActual);
                    }
                });
            });

            document.querySelectorAll('.btn-nav-prev').forEach(btn => {
                btn.addEventListener('click', function () {
                    if (indiceActual > 0) {
                        indiceActual--;
                        mostrarPaso(indiceActual);
                    }
                });
            });

            document.querySelectorAll('.cj-likert-option').forEach(opcion => {
                opcion.addEventListener('click', function () {
                    const grupo = this.closest('[data-pregunta-id]');
                    grupo.querySelectorAll('.cj-likert-option').forEach(o => o.classList.remove('selected'));
                    this.classList.add('selected');
                    this.querySelector('.cj-likert-input').checked = true;
                });
            });

            document.getElementById('form-evaluacion').addEventListener('submit', function (e) {
                const grupo = pasos[total - 1].querySelector('[data-pregunta-id]');
                const seleccionado = grupo.querySelector('.cj-likert-input:checked');
                if (!seleccionado) {
                    e.preventDefault();
                    alert('Selecciona una opción antes de finalizar.');
                }
            });
        })();
    </script>
</body>
</html>
