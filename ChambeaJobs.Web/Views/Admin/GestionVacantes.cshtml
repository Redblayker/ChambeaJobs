@model List<VacanteAdminDto>
@{
    ViewData["Title"] = "Gestión de Vacantes";
}

<div class="container py-5">
    <h2 class="mb-1">Gestión de Vacantes</h2>
    <p class="text-secondary mb-4">@Model.Count vacante@(Model.Count == 1 ? "" : "s") en total.</p>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="cj-card">
        <div class="table-responsive">
<table class="table align-middle">
            <thead>
                <tr><th>Título</th><th>Empresa</th><th>Categoría</th><th>Publicada</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td class="fw-semibold">@v.Titulo</td>
                        <td class="text-secondary">@v.EmpresaNombre</td>
                        <td><span class="cj-badge cj-badge-info">@v.CategoriaNombre</span></td>
                        <td class="text-secondary">@v.FechaPublicacion.ToString("dd/MM/yyyy")</td>
                        <td><span class="cj-badge @(v.Estado == "Activa" ? "cj-badge-success" : "cj-badge-info")">@v.Estado</span></td>
                        <td class="text-end">
                            @if (v.Estado == "Activa")
                            {
                                <form asp-controller="Admin" asp-action="DespublicarVacante" method="post" class="d-inline" onsubmit="return confirm('¿Despublicar esta vacante?');">
                                    <input type="hidden" name="id" value="@v.Id" />
                                    <button type="submit" class="btn btn-sm">Despublicar</button>
                                </form>
                            }
                            <form asp-controller="Admin" asp-action="EliminarVacanteAdmin" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta vacante permanentemente?');">
                                <input type="hidden" name="id" value="@v.Id" />
                                <button type="submit" class="btn btn-sm text-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
</div>
    </div>
</div>
