@model List<PagoAdminDto>
@{
    ViewData["Title"] = "Historial de pagos";
}

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-1">
        <div class="d-flex align-items-center justify-content-center flex-shrink-0"
             style="width:44px; height:44px; border-radius:var(--radius-md); background:#DEF4E9;">
            <i class="fa-solid fa-receipt" style="color:var(--color-success);"></i>
        </div>
        <h2 class="mb-0">Historial de pagos</h2>
    </div>
    <p class="text-secondary mb-4">Todos los pagos registrados por todas las empresas de la plataforma.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="cj-card mb-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-0">Empresa</label>
                <input type="text" name="nombreEmpresa" value="@ViewBag.NombreEmpresa" class="form-control" placeholder="Buscar por nombre..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-0">Estado</label>
                <select name="estadoPago" class="form-select">
                    <option value="">Todos</option>
                    <option value="Pendiente" selected="@(ViewBag.EstadoPago == "Pendiente")">Pendiente</option>
                    <option value="Aprobado" selected="@(ViewBag.EstadoPago == "Aprobado")">Aprobado</option>
                    <option value="Rechazado" selected="@(ViewBag.EstadoPago == "Rechazado")">Rechazado</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0">Desde</label>
                <input type="date" name="desde" value="@ViewBag.Desde" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0">Hasta</label>
                <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn cj-btn-primary w-100">Filtrar</button>
            </div>
        </form>
    </div>

    <div class="cj-card mb-4 d-inline-flex align-items-center gap-3" style="border-left: 4px solid var(--color-success);">
        <i class="fa-solid fa-sack-dollar fa-lg" style="color:var(--color-success);"></i>
        <div>
            <div class="fs-4 fw-bold" style="color:var(--color-ink);">$@(((decimal)ViewBag.TotalMostrado).ToString("0.00"))</div>
            <div class="small text-secondary">Total aprobado en los resultados mostrados</div>
        </div>
    </div>

    <div class="cj-card">
        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <i class="fa-solid fa-inbox fa-2x mb-3" style="color:var(--color-slate-soft);"></i>
                <p class="small text-secondary mb-0">No hay pagos que coincidan con estos filtros.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
<table class="table align-middle">
                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>Fecha de pago</th>
                        <th>Monto</th>
                        <th>Estado</th>
                        <th>Referencia</th>
                        <th>Revisado</th>
                        <th class="text-end">Comprobante</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pago in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@pago.EmpresaNombre</td>
                            <td class="text-secondary">@pago.FechaPago.ToString("dd/MM/yyyy")</td>
                            <td>$@pago.Monto.ToString("0.00")</td>
                            <td>
                                <span class="cj-badge @(pago.EstadoPago == "Aprobado" ? "cj-badge-success" : pago.EstadoPago == "Pendiente" ? "cj-badge-warning" : "cj-badge-error")">
                                    @pago.EstadoPago
                                </span>
                            </td>
                            <td class="small text-secondary">@pago.ReferenciaTransaccion</td>
                            <td class="small text-secondary">
                                @(pago.FechaRevision.HasValue ? pago.FechaRevision.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                            </td>
                            <td class="text-end">
                                @if (pago.EstadoPago == "Aprobado")
                                {
                                    <a asp-controller="Admin" asp-action="DescargarComprobante" asp-route-pagoId="@pago.PagoId" class="btn btn-sm cj-btn-outline" style="color:var(--color-primary-700); border-color:var(--color-primary-700);">
                                        <i class="fa-solid fa-file-arrow-down"></i> PDF
                                    </a>
                                }
                                else
                                {
                                    <span class="small text-secondary">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
</div>
        }
    </div>
</div>
