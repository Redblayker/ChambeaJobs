<?xml version="1.0" encoding="utf-8"?>
<!--
  Este web.config se usa como PLANTILLA BASE durante la publicación
  (dotnet publish / Visual Studio Publish). El proceso de publicación
  completa automáticamente el bloque <aspNetCore> con la ruta correcta
  al .dll compilado — no lo edites manualmente después de publicar,
  ya que se regenera cada vez.

  El bloque de <modules>/<handlers> para remover WebDAVModule SÍ se
  conserva tal cual, porque Somee.com (y varios hostings compartidos
  en Windows/IIS) tienen ese módulo activado por defecto, y bloquea
  las peticiones POST (login, registro, formularios) con un error
  HTTP 405 "Method Not Allowed" antes de que lleguen a la aplicación.
-->
<configuration>
  <location>
    <system.webServer>
      <!-- Evita el error 405 en POST causado por el módulo WebDAV de IIS -->
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Sube el límite de tamaño de peticiones (por defecto ~30MB en IIS)
           para permitir subir el Video Currículum (hasta 50MB) -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="62914560" />
        </requestFiltering>
      </security>
      <aspNetCore processPath="dotnet" arguments=".\ChambeaJobs.Web.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <!-- Se fuerza explícitamente a "Production" para no depender de
               cómo tenga configurado el servidor de hosting su variable de
               ambiente por defecto — así siempre se usa appsettings.Production.json
               (con la conexión real a la base de datos) y nunca el appsettings.json
               base (que tiene la conexión a LocalDB, solo para desarrollo local). -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
